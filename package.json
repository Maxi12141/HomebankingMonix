{
  "name": "monix-homebanking",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:celular": "vite --host --port 5173 --strictPort",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "node tests/e2e/visual.mjs",
    "check:fast": "node scripts/floor-guard.mjs && node scripts/floor-guard.mjs --base HEAD && tsc --noEmit && npm run test:unit",
    "check:task": "npm run check:fast && npm run test:sql && npm run build && (size-limit || echo AVISO: el bundle inicial empeoro, ver CONSTRAINTS.md) && (npm run test:e2e || echo AVISO: marca, accesibilidad o toques empeoro, ver CONSTRAINTS.md)",
    "check:perf": "node scripts/lighthouse.mjs",
    "check:full": "npm run check:task && (npm run check:perf || echo AVISO: la performance mobile empeoro, ver CONSTRAINTS.md) && (npm audit --omit=dev --audit-level=high || echo AVISO: la seguridad de dependencias empeoro, ver CONSTRAINTS.md)",
    "test:unit": "node --test tests/unit/monto.test.mjs tests/unit/errores.test.mjs",
    "test:sql": "node --test tests/sql/s1.test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@supabase/supabase-js": "^2.45.4",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.462.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-countup": "^6.5.3",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@electric-sql/pglite": "^0.5.8",
    "@size-limit/file": "^11.2.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "lighthouse": "^12.8.2",
    "playwright": "^1.63.0",
    "postcss": "^8.4.49",
    "size-limit": "^11.2.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-svgr": "^5.2.0"
  }
}
