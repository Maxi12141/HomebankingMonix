{
  "rewrites": [
    { "source": "/bc-api/:path*", "destination": "https://centralbank.brocoly.cc/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), nfc=(self), publickey-credentials-get=(self), publickey-credentials-create=(self)" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), nfc=(self), publickey-credentials-get=(self), publickey-credentials-create=(self)" }
      ]
    },
    {
      "source": "/monix-build.txt",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), nfc=(self), publickey-credentials-get=(self), publickey-credentials-create=(self)" }
      ]
    }
  ]
}
